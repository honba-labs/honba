# Copy to .env (git-ignored) and fill in: scripts/init_secrets.sh does this with mode 0600.
# Never commit real values. Configs reference these as ${VAR}.

# Zerodha Kite Connect (https://developers.kite.trade)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Daily token (expires ~06:00 IST); written by the login flow or pasted by hand.
ZERODHA_ACCESS_TOKEN=
# Only for headless daily login (optional).
ZERODHA_USER_ID=
ZERODHA_TOTP_SECRET=

# DhanHQ (https://dhanhq.co)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
