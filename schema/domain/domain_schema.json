          ],
          "type": "string"
        }
      ]
    },
    "Order": {
      "description": "A client order.\n\n``` use honba_messages::{ InstrumentId, Order, OrderId, OrderSide, OrderStatus, OrderType, TimeInForce, UnixNanos, Exchange, };\n\nlet order = Order::new( OrderId::new(\"O-1\"), InstrumentId::new(\"NIFTY50\", Exchange::new(\"NSE\")), OrderSide::Buy, OrderType::Limit, 75.0, Some(22_000.0), TimeInForce::Day, UnixNanos::from_u64(1), UnixNanos::from_u64(1), ); assert_eq!(order.status(), OrderStatus::Initialized); assert_eq!(order.quantity(), 75.0); ```\n\nInvariants (checked by [`Order::validate`] and on deserialization): `quantity` is finite and `> 0`; `price` and `trigger_price` are finite when present. An order is a record (it may come back from an exchange), so `side` may be `no_order_side`; intents are stricter.",
      "properties": {
        "instrument_id": {
          "$ref": "#/definitions/InstrumentId"
        },
        "order_id": {
          "$ref": "#/definitions/OrderId"
        },
        "order_type": {
          "$ref": "#/definitions/OrderType"
        },
        "price": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "quantity": {
          "format": "double",
          "type": "number"
        },
        "side": {
          "$ref": "#/definitions/OrderSide"
        },
        "status": {
          "$ref": "#/definitions/OrderStatus"
        },
        "time_in_force": {
          "$ref": "#/definitions/TimeInForce"
        },
        "trigger_price": {
          "description": "Stop trigger price; `None` unless the order is a stop order.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ts_event": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "ts_init": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "instrument_id",
        "order_id",
        "order_type",
        "quantity",
        "side",
        "status",
        "time_in_force",
        "ts_event",
        "ts_init"
      ],
      "type": "object"
    },
    "OrderId": {
      "description": "A client-assigned order identifier.",
      "type": "string"
    },
    "OrderIntent": {
      "description": "A strategy's desire to trade, before it becomes a concrete [`Order`].\n\nStrategies emit intents; the runner converts them into orders with unique ids and timestamps. This indirection keeps strategies free of bookkeeping they shouldn't care about.\n\nPrice fields by order type (checked by [`OrderIntent::validate`], on deserialization, and by [`OrderIntent::into_order`], so an invalid intent built with a constructor or struct literal never becomes an [`Order`]):\n\n| `order_type`  | `price` (limit) | `trigger_price` (stop) | |---------------|-----------------|------------------------| | `Market`      | none            | none                   | | `Limit`       | required        | none                   | | `StopMarket`  | none            | required               | | `StopLimit`   | required        | required               |\n\n``` use honba_strategy::OrderIntent; use honba_messages::{InstrumentId, OrderSide, OrderType, Exchange};\n\nlet intent = OrderIntent::market_buy( InstrumentId::new(\"NIFTY50\", Exchange::new(\"NSE\")), 75.0, ); assert_eq!(intent.side, OrderSide::Buy); assert_eq!(intent.order_type, OrderType::Market); ```",
      "properties": {
        "instrument_id": {
          "allOf": [
            {
              "$ref": "#/definitions/InstrumentId"
            }
          ],
          "description": "The instrument to trade."
        },
        "order_type": {
          "allOf": [
            {
              "$ref": "#/definitions/OrderType"
            }
          ],
          "description": "Execution instruction."
        },
        "price": {
          "description": "Limit price, for `Limit` and `StopLimit` orders.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "quantity": {
          "description": "Quantity to trade.",
          "format": "double",
          "type": "number"
        },
        "side": {
          "allOf": [
            {
              "$ref": "#/definitions/OrderSide"
            }
          ],
          "description": "Buy or sell."
        },
        "time_in_force": {
          "allOf": [
            {
              "$ref": "#/definitions/TimeInForce"
            }
          ],
          "description": "How long the order remains active."
        },
        "trigger_price": {
          "description": "Stop trigger price, for `StopMarket` and `StopLimit` orders.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "instrument_id",
        "order_type",
        "quantity",
        "side",
        "time_in_force"
      ],
      "type": "object"
    },
    "OrderSide": {
      "description": "Which side of the book an order sits on.",
      "oneOf": [
        {
          "description": "Buy side.",
          "enum": [
            "buy"
          ],
          "type": "string"
        },
        {
          "description": "Sell side.",
