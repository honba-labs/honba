          "type": "string"
        }
      ]
    },
    "BarSpecification": {
      "description": "Describes how a [`Bar`] aggregates its inputs.\n\n``` use honba_messages::{BarAggregation, BarSpecification, PriceType};\n\nlet spec = BarSpecification::new(1, BarAggregation::Minute, PriceType::Last); assert_eq!(spec.step(), 1); assert_eq!(spec.aggregation(), BarAggregation::Minute); ```\n\n`step` must be at least 1; deserializing a zero step fails.",
      "properties": {
        "aggregation": {
          "$ref": "#/definitions/BarAggregation"
        },
        "price_type": {
          "$ref": "#/definitions/PriceType"
        },
        "step": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "aggregation",
        "price_type",
        "step"
      ],
      "type": "object"
    },
