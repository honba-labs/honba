    "Message": {
      "additionalProperties": false,
      "description": "The envelope that carries an [`Event`] plus Honba-side metadata.\n\nThis is the versioned unit of the wire contract: its JSON form is `{\"schema_version\": 1, \"event\": {...}, \"ts_init\": n}`, and deserializing a message with any other `schema_version` fails.\n\n``` use honba_messages::{Event, Message, UnixNanos, QuoteTick, InstrumentId, Exchange};\n\nlet quote = QuoteTick::new( InstrumentId::new(\"NIFTY50\", Exchange::new(\"NSE\")), 22_000.0, 22_001.0, 50.0, 75.0, UnixNanos::from_u64(1), UnixNanos::from_u64(1), ); let msg = Message::new(Event::Quote(quote), UnixNanos::from_u64(2)); assert!(msg.event().is_market_data()); assert_eq!(msg.schema_version(), honba_messages::SCHEMA_VERSION); ```",
      "properties": {
        "event": {
          "$ref": "#/definitions/Event"
        },
        "schema_version": {
          "description": "Rendered as a plain `u32` in the schema, matching the JSON wire form (the internal `SchemaVersion` unit type would otherwise emit `{}`).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "ts_init": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "event",
        "schema_version",
        "ts_init"
      ],
      "type": "object"
    },
    "MetricPeriod": {
      "description": "Evaluation period dimension for fundamental or snapshot metrics.",
